# Environment Configuration for CodeSync
# Copy this file to .env and fill in your values

# Optional: Backend URL for development (leave empty for production)
REACT_APP_BACKEND_URL=http://localhost:5000

# Disable source maps in production builds
GENERATE_SOURCEMAP=false

# Clerk Authentication
REACT_APP_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Code Execution: Uses Piston API (https://emkc.org/api/v2/piston)
# No API key required - Piston is a free, open-source API
# No Docker required - uses the public hosted instance

# Production environment (set by Render)
# NODE_ENV=production
# PORT=10000
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
